# ---- FFmpeg shared binaries (ST-05) ----
# Downloaded on demand by scripts/download-ffmpeg.ps1; never committed.
lib/ffmpeg/

# ---- RIFE model + ONNX Runtime binaries (ST-13) ----
# Large binaries downloaded on demand by scripts/build-native.ps1; never committed.
lib/rife/*.onnx
lib/onnxruntime/
*.onnx

# ---- FSR 4 / FidelityFX SDK (ST-14) ----
# License-gated GPUOpen SDK supplied by the integrator via -DCATRA_FSR_SDK_ROOT;
# never vendored or downloaded by this repo. FSR 1 (EASU) is the self-contained
# fallback when the SDK is absent.
lib/fsr-sdk/

# ---- AMF SDK headers (ST-16) ----
# Headers-only GPUOpen SDK (https://github.com/GPUOpen-LibrariesAndSDKs/AMF)
# supplied by the integrator via -DCATRA_AMF_ROOT; never vendored or downloaded
# by this repo. The AMF runtime (amfrt64.dll) ships with the AMD driver. Without
# the headers the encode backend compiles to a CATRA_ERR_NOT_IMPL stub.
lib/amf/
native/catra-gpu/vcpkg_installed/
native/catra-gpu/build/
native/catra-gpu/install/
