# =============================================================================
# CATRA .gitignore
# =============================================================================

# ---- .NET / Visual Studio ----
bin/
obj/
out/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.idea/
*.DotSettings.user
*.binlog

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
bld/
[Bb]in/
[Oo]bj/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/

# Test results / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
coverage*.json
coverage*.xml

# ---- Native build artifacts ----
*.pdb
*.ilk
*.exp
*.lib
*.obj
*.o
*.a
*.so
*.so.*
*.dylib

# Binaries (DLLs/EXEs are build outputs or vendored downloads — never commit;
# FFX/FFmpeg/ONNX binaries are downloaded or built on demand by scripts).
*.dll
*.exe

# ---- lib/ vendored third-party ----
# Everything under lib/ is vendor-supplied or downloaded on demand EXCEPT the
# FidelityFX SDK 2.3.0 headers (small, required to build the FFX runtime loader,
# MIT license — tracked intentionally).
lib/*
!lib/FidelityFX-SDK-2.3.0/
# Notes on the ignored content:
#   lib/ffmpeg/        -> scripts/download-ffmpeg.ps1 (avcodec incl. libx265/nvenc/qsv/amf)
#   lib/rife/          -> RIFE ONNX models + export guide (*.onnx)
#   lib/onnxruntime/   -> ONNX Runtime binaries (scripts/build-native.ps1)
#   lib/amf/           -> AMF SDK headers, supplied via -DCATRA_AMF_ROOT
#   lib/FidelityFX-Samples-v2.3.0-prebuilt/ -> GPUOpen prebuilt samples (reference only)
#   lib/docs/          -> local reference docs

# ---- Native bridge build trees ----
native/catra-gpu/build/
native/catra-gpu/install/
native/catra-gpu/vcpkg_installed/

# ---- Models ----
*.onnx

# ---- Editor / tooling ----
.vscode/

# ---- OS ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---- Logs / temp / agent artifacts ----
*.log
*.tmp
*.cache
.pi-subagents/
