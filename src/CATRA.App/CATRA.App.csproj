<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- FFmpeg.AutoGen: App.xaml.cs configures ffmpeg.RootPath at startup (ST-05). -->
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CATRA.UI\CATRA.UI.csproj" />
  </ItemGroup>

  <!-- ST-12: deploy the native bridge DLL when it has been built.
       The DLL path is resolved after the native BeforeBuild runs, so the
       Exists() check works on the FIRST build (no prior manual build needed).
       Files are added dynamically in CopyNativeDlls target below. -->
  <PropertyGroup>
    <CatraNativeDir>$(MSBuildThisFileDirectory)..\..\native\catra-gpu\install\runtimes\win-x64\native</CatraNativeDir>
    <CatraNativeDll>$(CatraNativeDir)\catra-gpu.dll</CatraNativeDll>
  </PropertyGroup>

  <!-- ST-27: deploy RIFE ONNX model when present in lib/rife/.
       The native bridge looks for rife_v4.onnx relative to the module directory.
       The Condition keeps `dotnet build` green on machines without the model. -->
  <PropertyGroup>
    <RifeModelDir>$(MSBuildThisFileDirectory)\..\..\lib\rife</RifeModelDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(RifeModelDir)\rife_v4.onnx')">
    <None Include="$(RifeModelDir)\rife_v4.onnx" CopyToOutputDirectory="PreserveNewest" Link="lib\rife\rife_v4.onnx" Visible="false" />
  </ItemGroup>

  <!-- ST-05: deploy FFmpeg native DLLs when present in lib/ffmpeg/.
       scripts/download-ffmpeg.ps1 populates that folder. App.xaml.cs sets
       ffmpeg.RootPath to AppContext.BaseDirectory/lib/ffmpeg at startup.
       The Condition keeps `dotnet build` green on machines without FFmpeg. -->
  <PropertyGroup>
    <FfmpegLibDir>$(MSBuildThisFileDirectory)\..\..\lib\ffmpeg</FfmpegLibDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(FfmpegLibDir)')">
    <None Include="$(FfmpegLibDir)\*.dll" CopyToOutputDirectory="PreserveNewest" Link="lib\ffmpeg\%(Filename)%(Extension)" Visible="false" />
    <!-- Audio mux (ST-17) shells out to the ffmpeg/ffprobe CLIs; deploy them
         alongside the shared DLLs when the download script brought them in. -->
    <None Include="$(FfmpegLibDir)\*.exe" CopyToOutputDirectory="PreserveNewest" Link="lib\ffmpeg\%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <!-- =====================================================================
       NATIVE BUILD INTEGRATION (BeforeBuild target)
       =====================================================================
       Automatically builds the catra-gpu native bridge (C++/D3D12) before
       building the .NET project. This ensures the native DLL is always
       up-to-date when you press Ctrl+B / F6 in Visual Studio.
       The script passes $(Configuration) so Debug/Release both work.
       ===================================================================== -->
  <Target Name="BuildNativeBridge" BeforeTargets="Build" Condition="'$(BuildingInsideVisualStudio)' == 'true' Or '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <NativeBuildScript>$(MSBuildThisFileDirectory)..\..\scripts\build-native-vs.bat</NativeBuildScript>
      <NativeBuildEnabled Condition="Exists('$(NativeBuildScript)')">true</NativeBuildEnabled>
      <NativeBuildEnabled Condition="!Exists('$(NativeBuildScript)')">false</NativeBuildEnabled>
      <CatraOutputNativeDir>$(OutDir)runtimes\win-x64\native</CatraOutputNativeDir>
    </PropertyGroup>

    <!-- Step 1: Compile the native bridge (Debug|Release) -->
    <Message Importance="high" Text="[NativeBuild] Building catra-gpu native bridge ($(Configuration))..." Condition="'$(NativeBuildEnabled)' == 'true'" />
    <Exec Command="&quot;$(NativeBuildScript)&quot; $(Configuration)"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\.."
          ConsoleToMSBuild="true"
          StandardOutputImportance="normal"
          StandardErrorImportance="high"
          IgnoreExitCode="false"
          Condition="'$(NativeBuildEnabled)' == 'true'" />
    <Message Importance="high" Text="[NativeBuild] Native build complete." Condition="'$(NativeBuildEnabled)' == 'true'" />
    <Warning Text="[NativeBuild] build-native-vs.bat not found at $(NativeBuildScript). Skipping native build." Condition="'$(NativeBuildEnabled)' != 'true'" />

    <!-- Step 2: Copy native DLLs/PDB directly into the output directory.
         This runs inside the same target as the build, so it works on the
         very first build (no prior DLL needed at project load time). -->
    <MakeDir Directories="$(CatraOutputNativeDir)" Condition="'$(NativeBuildEnabled)' == 'true'" />
    <Copy SourceFiles="$(CatraNativeDll)"
          DestinationFolder="$(CatraOutputNativeDir)"
          SkipUnchangedFiles="true"
          Condition="'$(NativeBuildEnabled)' == 'true' And Exists('$(CatraNativeDll)')" />
    <Copy SourceFiles="$(CatraNativeDir)\catra-gpu.pdb"
          DestinationFolder="$(CatraOutputNativeDir)"
          SkipUnchangedFiles="true"
          Condition="'$(NativeBuildEnabled)' == 'true' And Exists('$(CatraNativeDir)\catra-gpu.pdb')" />
    <ItemGroup Condition="'$(NativeBuildEnabled)' == 'true' And Exists('$(CatraNativeDir)\onnxruntime.dll')">
      <_OnnxDlls Include="$(CatraNativeDir)\onnxruntime*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_OnnxDlls)"
          DestinationFolder="$(CatraOutputNativeDir)"
          SkipUnchangedFiles="true"
          Condition="'$(NativeBuildEnabled)' == 'true'" />

    <!-- SPRINT_04 ST-01: deploy the 8 FFX runtime DLLs (list A1) + MIT license
         (FFX-LICENSE.txt) next to catra-gpu.dll so ffx_runtime's LoadLibrary
         resolves the sibling DLLs from the module directory. Mirrors the
         _OnnxDlls pattern above; the Exists() gate keeps the build green on
         machines without a native install. -->
    <ItemGroup Condition="'$(NativeBuildEnabled)' == 'true' And Exists('$(CatraNativeDir)\amd_fidelityfx_loader_dx12.dll')">
      <_FfxDlls Include="$(CatraNativeDir)\amd_fidelityfx_loader_dx12.dll;$(CatraNativeDir)\amd_fidelityfx_upscaler_dx12.dll;$(CatraNativeDir)\amd_fidelityfx_framegeneration_dx12.dll;$(CatraNativeDir)\amd_ags_x64.dll;$(CatraNativeDir)\amd_acs_x64.dll;$(CatraNativeDir)\D3D12Core.dll;$(CatraNativeDir)\dxcompiler.dll;$(CatraNativeDir)\dxil.dll;$(CatraNativeDir)\FFX-LICENSE.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(_FfxDlls)"
          DestinationFolder="$(CatraOutputNativeDir)"
          SkipUnchangedFiles="true"
          Condition="'$(NativeBuildEnabled)' == 'true' And Exists('$(CatraNativeDir)\amd_fidelityfx_loader_dx12.dll')" />
  </Target>

</Project>
