<Window x:Class="CATRA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CATRA"
        Width="960"
        Height="600"
        WindowStyle="None"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="4" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusBarRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (collapsed by the player in fullscreen, ST-06) -->
        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#1E1E2E">
            <Grid>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Text="CATRA" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="44"
                            Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="MinimizeButton_Click"
                            Content="&#x2013;"
                            Foreground="#FFFFFF"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Width="44"
                            Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseButton_Click"
                            Content="&#x2715;"
                            Foreground="#FFFFFF"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content region -->
        <Frame x:Name="ContentFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden" />

        <!-- Status bar (ST-10): web control panel URL -->
        <Border x:Name="StatusBarBorder"
                Grid.Row="2"
                Background="#1E1E2E"
                Padding="12,4"
                Visibility="Collapsed">
            <TextBlock x:Name="WebPanelUrlText"
                       Cursor="Hand"
                       FontSize="12"
                       Foreground="#8BE9FD"
                       Text="📱 Painel: ..."
                       MouseLeftButtonDown="WebPanelUrl_Click" />
        </Border>
    </Grid>
</Window>
