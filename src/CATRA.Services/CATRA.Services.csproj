<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- FFmpeg.AutoGen (VideoDecoder/AudioDecoder) and Vortice (VideoRenderer)
         expose native pointers; the playback layer manipulates them directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel embedded HTTP server with Range requests for DLNA casting (ST-08).
         Shared framework reference: flows transitively to referencing projects and
         does not interfere with WPF (CATRA.UI / CATRA.App). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- FFmpeg bindings: D3D11VA hw decode + audio decode (ST-05). -->
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <!-- WASAPI output for the audio renderer (ST-05). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NReco.VideoInfo" Version="1.2.1" />
    <!-- D3D11/DXGI swapchain rendering into the WPF HwndHost (ST-05). -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
    <PackageReference Include="Vortice.DXGI" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CATRA.Data\CATRA.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ST-12: let NativeBridgeTests drive the internal INativeLibrary seam
         (fake loader) so the P/Invoke wrapper logic is testable without the
         native catra-gpu.dll. -->
    <InternalsVisibleTo Include="CATRA.Services.Tests" />
  </ItemGroup>

</Project>
