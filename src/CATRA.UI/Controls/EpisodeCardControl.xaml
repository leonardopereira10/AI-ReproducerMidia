<UserControl x:Class="CATRA.UI.Controls.EpisodeCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CATRA.UI.Converters"
             xmlns:helpers="clr-namespace:CATRA.UI.Helpers">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:ProgressToBadgeConverter x:Key="ProgressToBadge" />
        <converters:ThumbnailPathToImageConverter x:Key="ThumbnailToImage" />
        <!-- ContextMenu lives in its own visual/data tree, so it cannot reach
             the UserControl via RelativeSource. This proxy exposes the control
             (and its command DPs) as a static resource for the menu items. -->
        <helpers:BindingProxy x:Key="ControlProxy"
                              Data="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </UserControl.Resources>

    <!-- DataContext is an EpisodeDetail (set by the host ItemsControl). -->
    <Button Padding="0"
            Background="Transparent"
            Command="{Binding PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}"
            Cursor="Hand"
            Style="{StaticResource BaseButtonStyle}">
        <Button.ContextMenu>
            <!-- ContextMenu lives in its own tree: reach the control (its
                 PlacementTarget) to get the host view-model commands. -->
            <ContextMenu>
                <MenuItem Command="{Binding Data.PlayCommand, Source={StaticResource ControlProxy}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Header="▶ Reproduzir" />
                <Separator />
                <MenuItem Command="{Binding Data.ToggleWatchedCommand, Source={StaticResource ControlProxy}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Header="Marcar/Desmarcar assistido" />
                <MenuItem Command="{Binding Data.RenameCommand, Source={StaticResource ControlProxy}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Header="Renomear..." />
                <MenuItem Command="{Binding Data.SetCoverCommand, Source={StaticResource ControlProxy}}"
                          Header="Configurar capa..." />
                <MenuItem Command="{Binding Data.DetailsCommand, Source={StaticResource ControlProxy}}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Header="Detalhes" />
            </ContextMenu>
        </Button.ContextMenu>

        <Border Width="160"
                Margin="6"
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <!-- Thumbnail (ST-09): real frame over the placeholder; when
                     ThumbnailPath is null the converter yields null and the
                     placeholder stays visible (RF-08 fallback). -->
                <Grid Height="84">
                    <Border Background="{DynamicResource SeekBarBackgroundBrush}" CornerRadius="4">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   Foreground="{DynamicResource SectionHeaderForegroundBrush}"
                                   Text="🎞" />
                    </Border>
                    <Image HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailToImage}}"
                           Stretch="UniformToFill" />
                    <!-- Status badge: ✓ watched / ▶ progress / ○ untouched -->
                    <Border Margin="0,6,6,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource BadgeStyle}">
                        <TextBlock Style="{StaticResource BadgeTextStyle}"
                                   Text="{Binding Converter={StaticResource ProgressToBadge}}" />
                    </Border>
                </Grid>

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource CardForegroundBrush}"
                               Text="{Binding EpisodeLabel}" />
                    <!-- Progress percentage when playback started (RN-03) -->
                    <TextBlock Margin="8,0,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding ProgressPct, StringFormat={}{0:F0}%}"
                               Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock Foreground="{DynamicResource SectionHeaderForegroundBrush}"
                           FontSize="12"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title}" />
            </StackPanel>
        </Border>
    </Button>
</UserControl>
