<UserControl x:Class="CATRA.UI.Controls.MediaCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CATRA.UI.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:ThumbnailPathToImageConverter x:Key="ThumbnailToImage" />
    </UserControl.Resources>

    <!-- DataContext is a MediaItemSummary (set by the host ItemsControl). -->
    <Button Padding="0"
            Background="Transparent"
            Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}"
            Cursor="Hand"
            Style="{StaticResource BaseButtonStyle}">
        <Border Width="184"
                Margin="6"
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <!-- Thumbnail (ST-09): real cover image over the placeholder;
                     when ThumbnailPath is null the converter yields null and the
                     placeholder stays visible (RF-08 fallback). -->
                <Grid Height="104">
                    <Border Background="{DynamicResource SeekBarBackgroundBrush}" CornerRadius="4">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   Foreground="{DynamicResource SectionHeaderForegroundBrush}"
                                   Text="🎬" />
                    </Border>
                    <Image HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailToImage}}"
                           Stretch="UniformToFill" />
                    <!-- RN-03 badge -->
                    <Border Margin="0,6,6,0"
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="8"
                            Visibility="{Binding HasContinueWatching, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BadgeForegroundBrush}"
                                   Text="Continuar Assistindo" />
                    </Border>
                </Grid>

                <TextBlock Margin="0,8,0,0"
                           Foreground="{DynamicResource CardForegroundBrush}"
                           FontWeight="SemiBold"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title}" />

                <DockPanel Margin="0,2,0,0">
                    <TextBlock DockPanel.Dock="Left"
                               FontSize="12"
                               Foreground="{DynamicResource SectionHeaderForegroundBrush}"
                               Text="{Binding TypeDisplay}" />
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding ProgressDisplay}"
                               TextAlignment="Right" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Button>
</UserControl>
