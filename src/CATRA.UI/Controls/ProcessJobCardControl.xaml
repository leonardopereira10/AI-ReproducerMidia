<UserControl x:Class="CATRA.UI.Controls.ProcessJobCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CATRA.UI.Converters">
    <!-- Binds to an ActiveJobItem DataContext (inherited from ItemsControl).
         Shows the job being processed: EP + title, progress bar with the active
         step, and ETA (ST-19, Tela 3). Supports parallel jobs. -->
    <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
        <StackPanel>
            <DockPanel>
                <TextBlock FontWeight="SemiBold"
                           Foreground="{DynamicResource CardForegroundBrush}">
                    <Run Text="{Binding EpisodeLabel, Mode=OneWay}" />
                    <Run Text=" — " />
                    <Run Text="{Binding Title, Mode=OneWay}" />
                </TextBlock>
                <Button HorizontalAlignment="Right"
                        Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        Content="✕ Cancelar"
                        DockPanel.Dock="Right"
                        Style="{StaticResource BaseButtonStyle}" />
            </DockPanel>

            <ProgressBar Height="10"
                         Margin="0,8,0,0"
                         Maximum="100"
                         Minimum="0"
                         Value="{Binding ProgressPct, Mode=OneWay}" />

            <DockPanel Margin="0,6,0,0">
                <TextBlock Foreground="{DynamicResource SectionHeaderForegroundBrush}"
                           Text="{Binding ProgressText, Mode=OneWay}" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
