<UserControl x:Class="CATRA.UI.Controls.TransportControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CATRA.UI.Controls"
             xmlns:converters="clr-namespace:CATRA.UI.Converters">
    <UserControl.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeConverter" />
        <converters:PlaybackStateToIconConverter x:Key="StateIconConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- DataContext: PlayerViewModel (inherited from the PlayerView) -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Seek bar + time ("12:34 / 22:00") -->
            <DockPanel Grid.Row="0">
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"
                           FontFamily="Consolas"
                           FontSize="13"
                           Foreground="{DynamicResource WindowForegroundBrush}">
                    <Run Text="{Binding Position, Converter={StaticResource TimeConverter}, Mode=OneWay}" />
                    <Run Text=" / " />
                    <Run Text="{Binding Duration, Converter={StaticResource TimeConverter}, Mode=OneWay}" />
                </TextBlock>

                <controls:SeekBarControl VerticalAlignment="Center"
                                         Maximum="{Binding DurationSeconds, Mode=OneWay}"
                                         SeekCompletedCommand="{Binding EndSeekCommand}"
                                         SeekStartedCommand="{Binding BeginSeekCommand}"
                                         Value="{Binding PositionSeconds, Mode=TwoWay}" />
            </DockPanel>

            <!-- Transport buttons -->
            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Width="40"
                            Command="{Binding PlayPauseToggleCommand}"
                            Content="{Binding State, Converter={StaticResource StateIconConverter}, Mode=OneWay}"
                            FontSize="14"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTip="Play/Pause" />
                    <Button Width="40"
                            Margin="8,0,0,0"
                            Command="{Binding StopCommand}"
                            Content="⏹"
                            FontSize="14"
                            Style="{StaticResource BaseButtonStyle}"
                            ToolTip="Parar" />

                    <Button Width="40"
                            Margin="8,0,0,0"
                            Command="{Binding PreviousEpisodeCommand}"
                            Content="⏮"
                            FontSize="14"
                            Style="{StaticResource BaseButtonStyle}"
                            ToolTip="Epis\u00f3dio anterior"
                            Visibility="{Binding HasPreviousEpisode, Converter={StaticResource BoolToVisibility}}" />

                    <Button Width="40"
                            Margin="8,0,0,0"
                            Command="{Binding NextEpisodeCommand}"
                            Content="⏭"
                            FontSize="14"
                            Style="{StaticResource BaseButtonStyle}"
                            ToolTip="Pr\u00f3ximo epis\u00f3dio"
                            Visibility="{Binding HasNextEpisode, Converter={StaticResource BoolToVisibility}}" />

                    <controls:VolumeControl Margin="16,0,0,0"
                                            IsMuted="{Binding IsMuted, Mode=TwoWay}"
                                            MuteCommand="{Binding ToggleMuteCommand}"
                                            Volume="{Binding Volume, Mode=TwoWay}" />

                    <Button Margin="16,0,0,0"
                            Command="{Binding SkipIntroCommand}"
                            Content="⏭ Pular Abertura"
                            Style="{StaticResource BaseButtonStyle}"
                            ToolTip="{Binding SkipIntroTooltip}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <!-- Profile indicator placeholder (real indicator: ST-20) -->
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SectionHeaderForegroundBrush}"
                               Text="{Binding ProfileIndicator}"
                               ToolTip="Perfil do arquivo (ST-20)" />

                    <!-- DLNA cast button + device dropdown (ST-08) -->
                    <controls:CastButtonControl />

                    <Button Margin="8,0,0,0"
                            Command="{Binding ToggleFullscreenCommand}"
                            Content="⛶ Tela Cheia"
                            Style="{StaticResource BaseButtonStyle}"
                            ToolTip="Tela cheia (F11 / ESC)" />

                    <Button Margin="8,0,0,0"
                            Command="{Binding CloseCommand}"
                            Content="← Voltar"
                            Style="{StaticResource BaseButtonStyle}"
                            ToolTip="Fechar player" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
