<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <Color x:Key="WindowBackgroundColor">#1E1E1E</Color>
    <Color x:Key="WindowForegroundColor">#E0E0E0</Color>
    <Color x:Key="CardBackgroundColor">#2D2D2D</Color>
    <Color x:Key="CardForegroundColor">#E0E0E0</Color>
    <Color x:Key="CardBorderColor">#3D3D3D</Color>
    <Color x:Key="AccentColor">#60CDFF</Color>
    <Color x:Key="AccentHoverColor">#4BB8F0</Color>
    <Color x:Key="SeekBarBackgroundColor">#3D3D3D</Color>
    <Color x:Key="SeekBarProgressColor">#60CDFF</Color>
    <Color x:Key="SeekBarThumbColor">#60CDFF</Color>
    <Color x:Key="ButtonBackgroundColor">#3D3D3D</Color>
    <Color x:Key="ButtonForegroundColor">#E0E0E0</Color>
    <Color x:Key="ButtonHoverColor">#4D4D4D</Color>
    <Color x:Key="SectionHeaderForegroundColor">#CCCCCC</Color>
    <Color x:Key="BadgeBackgroundColor">#60CDFF</Color>
    <Color x:Key="BadgeForegroundColor">#1E1E1E</Color>
    <Color x:Key="PlayerBackgroundColor">#000000</Color>

    <!-- Dark Theme Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource WindowForegroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardForegroundBrush" Color="{StaticResource CardForegroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="SeekBarBackgroundBrush" Color="{StaticResource SeekBarBackgroundColor}" />
    <SolidColorBrush x:Key="SeekBarProgressBrush" Color="{StaticResource SeekBarProgressColor}" />
    <SolidColorBrush x:Key="SeekBarThumbBrush" Color="{StaticResource SeekBarThumbColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource ButtonForegroundColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="SectionHeaderForegroundBrush" Color="{StaticResource SectionHeaderForegroundColor}" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="{StaticResource BadgeBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="{StaticResource BadgeForegroundColor}" />
    <SolidColorBrush x:Key="PlayerBackgroundBrush" Color="{StaticResource PlayerBackgroundColor}" />

</ResourceDictionary>
