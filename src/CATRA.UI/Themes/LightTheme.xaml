<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors -->
    <Color x:Key="WindowBackgroundColor">#FFFFFF</Color>
    <Color x:Key="WindowForegroundColor">#1A1A1A</Color>
    <Color x:Key="CardBackgroundColor">#F5F5F5</Color>
    <Color x:Key="CardForegroundColor">#1A1A1A</Color>
    <Color x:Key="CardBorderColor">#E0E0E0</Color>
    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="AccentHoverColor">#106EBE</Color>
    <Color x:Key="SeekBarBackgroundColor">#E0E0E0</Color>
    <Color x:Key="SeekBarProgressColor">#0078D4</Color>
    <Color x:Key="SeekBarThumbColor">#0078D4</Color>
    <Color x:Key="ButtonBackgroundColor">#E8E8E8</Color>
    <Color x:Key="ButtonForegroundColor">#1A1A1A</Color>
    <Color x:Key="ButtonHoverColor">#D0D0D0</Color>
    <Color x:Key="SectionHeaderForegroundColor">#333333</Color>
    <Color x:Key="BadgeBackgroundColor">#0078D4</Color>
    <Color x:Key="BadgeForegroundColor">#FFFFFF</Color>
    <Color x:Key="PlayerBackgroundColor">#000000</Color>

    <!-- Light Theme Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource WindowForegroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardForegroundBrush" Color="{StaticResource CardForegroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="SeekBarBackgroundBrush" Color="{StaticResource SeekBarBackgroundColor}" />
    <SolidColorBrush x:Key="SeekBarProgressBrush" Color="{StaticResource SeekBarProgressColor}" />
    <SolidColorBrush x:Key="SeekBarThumbBrush" Color="{StaticResource SeekBarThumbColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource ButtonForegroundColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="SectionHeaderForegroundBrush" Color="{StaticResource SectionHeaderForegroundColor}" />
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="{StaticResource BadgeBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="{StaticResource BadgeForegroundColor}" />
    <SolidColorBrush x:Key="PlayerBackgroundBrush" Color="{StaticResource PlayerBackgroundColor}" />

</ResourceDictionary>
