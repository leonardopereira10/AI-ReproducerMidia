<Page x:Class="CATRA.UI.Views.PlayerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CATRA.UI.Controls"
      xmlns:converters="clr-namespace:CATRA.UI.Converters"
      Background="{DynamicResource PlayerBackgroundBrush}"
      Focusable="True"
      KeepAlive="True"
      Title="CATRA — Player">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid x:Name="RootGrid" MouseMove="RootGrid_MouseMove">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video area: black letterbox; the host is aspect-fit sized in code-behind -->
        <Grid x:Name="VideoArea"
              Grid.Row="0"
              Background="{DynamicResource PlayerBackgroundBrush}"
              SizeChanged="VideoArea_SizeChanged">
            <controls:VideoHostControl x:Name="VideoHost"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Loaded="VideoHost_Loaded" />
        </Grid>

        <!-- Playback error overlay -->
        <Border Grid.Row="0"
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardStyle}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="{DynamicResource WindowForegroundBrush}"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Transport bar (auto-hides after 3s without mouse movement) -->
        <controls:TransportControls x:Name="TransportBar" Grid.Row="1" />
    </Grid>
</Page>
